# ---------------------------------------------------------------------------
# Frontend (Vite). Only VITE_* variables reach the browser bundle.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_DEV_PORT=5180

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
# Origin allowed by CORS. Must match where the frontend is actually served.
FRONTEND_ORIGIN=http://localhost:5180
# Optional extra origins, comma separated (e.g. a Vercel preview domain).
ADDITIONAL_CORS_ORIGINS=

# HMAC key for session tokens. Leave blank locally and one is generated under
# STORAGE_DIR. Set an explicit value in production so tokens survive redeploys.
SESSION_SECRET=

# Persistence. sqlite:// URLs only - see "Not yet integrated" in the README.
DATABASE_URL=sqlite:///./var/close_pack.db
# Uploaded documents and exported packs are written here.
STORAGE_DIR=./var/storage

# SuperDocs. "mock" runs fully offline; "live" requires SUPERDOCS_API_KEY.
SUPERDOCS_MODE=mock
SUPERDOCS_API_KEY=
SUPERDOCS_BASE_URL=https://api.superdocs.com
